# ==============================================================================
# Airflow
# ==============================================================================

# User ID used in Airflow containers (run: id -u to get yours)
AIRFLOW_UID=1000

# ==============================================================================
# PostgreSQL (Application Database)
# ==============================================================================

# Connection string for the virginia_court_cases application database.
# NOTE: This is separate from the airflow metadata database managed internally.
# Fail-fast: the application will error immediately if this is not set.
DATABASE_URL=postgresql://user:pass@localhost:5432/virginia_court_cases

# ==============================================================================
# DuckDB (Analytics / Gold Layer)
# ==============================================================================

# Path to the Gold-layer DuckDB file, relative to the project root.
# Used by the Streamlit dashboard (src/analysis/app.py).
DUCKDB_PATH=output/gold/court_analytics.duckdb
